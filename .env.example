# Copie para fora do git (por exemplo /etc/openclaw-gateway.env) e preencha lá.
# Este arquivo fica vazio de propósito. Não grave chave, token, domínio ou e-mail.

# Porta HTTP. Em produção use um número fixo (o healthcheck chama 127.0.0.1:$PORT/health).
# Vazio: o processo usa 3463. Não use 0 em produção.
PORT=

# Interface de escuta. Vazio: 0.0.0.0.
# No container deixe vazio. Em processo direto na máquina, atrás de proxy local, use 127.0.0.1.
HOST=

# Provedor principal. Obrigatório quando LLM_MOCK está vazio.
OPENAI_API_KEY=

# Só é chamado se o OpenAI não responder. Pode ficar vazio.
ANTHROPIC_API_KEY=

# 1 apenas em teste local, sem chave e sem rede.
# Em produção deixe vazio. Com NODE_ENV=production e LLM_MOCK=1 o processo recusa subir.
LLM_MOCK=

# URL do projeto Supabase deste ambiente, sem barra no final.
# O processo não chama essa URL; ela identifica de qual projeto é o JWT.
SUPABASE_URL=

# Segredo HMAC (JWT Secret) do mesmo projeto. Com valor, o Bearer é verificado.
# Sem valor, o JWT só é decodificado. Em produção preencha.
SUPABASE_JWT_SECRET=
